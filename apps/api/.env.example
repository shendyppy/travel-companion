# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ===========================================
# LLM PROVIDER CONFIGURATION
# ===========================================

# Choose your AI provider: gemini, glm, openai, or custom
# The app will auto-detect based on which API key is present
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Get it from: https://makersuite.google.com/app/apikey
# Models: gemini-2.5-flash (default), gemini-2.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Z.ai GLM ---
# Get it from: https://open.bigmodel.cn/
# Models: glm-4.6 (default), glm-4
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4.6

# --- OpenAI ---
# Get it from: https://platform.openai.com/api-keys
# Models: gpt-4o (default), gpt-4o-mini, gpt-3.5-turbo
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Custom Provider ---
# For any OpenAI-compatible API
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_MODEL=custom-model-name
CUSTOM_API_BASE=https://your-api-endpoint.com/v1

# --- Universal LLM Settings ---
# Temperature: 0.0 = deterministic, 1.0 = creative
LLM_TEMPERATURE=0.7

# Max tokens in response (0 = use model default)
LLM_MAX_TOKENS=0

# Thinking budget for Gemini (reasoning tokens, 0 = disabled)
THINKING_BUDGET=5000

# ===========================================
# EXTERNAL API CONFIGURATION
# ===========================================

# --- Amadeus Flight API ---
# Get it from: https://developers.amadeus.com/my-apps
# Required for flight search functionality
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# --- Google Flights API (via RapidAPI) ---
# Get it from: https://rapidapi.com/DataCrawler/api/google-flights-data
# Primary flight search provider (fallback to Amadeus if unavailable)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=google-flights-data.p.rapidapi.com
GOOGLE_FLIGHTS_ENABLED=true

# ===========================================
# USAGE EXAMPLES
# ===========================================

# Example 1: Use GLM-4.6
# LLM_PROVIDER=glm
# GLM_API_KEY=sk-xxxxxxxxxxxxxxxxxx
# GLM_MODEL=glm-4.6

# Example 2: Use Gemini Pro
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-pro
# THINKING_BUDGET=10000

# Example 3: Use OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o
# LLM_TEMPERATURE=0.8

# Example 4: Custom API (like Local LLM)
# LLM_PROVIDER=custom
# CUSTOM_API_KEY=your-key
# CUSTOM_API_BASE=http://localhost:8080/v1
# CUSTOM_MODEL=llama-2-7b-chat

# ===========================================
# REDIS CONFIGURATION (for production)
# ===========================================

# Redis URL for session management
# Local: redis://localhost:6379
# Cloud Run with Memorystore: redis://10.0.0.3:6379
REDIS_URL=

# Session TTL in seconds (default: 1 hour)
REDIS_SESSION_TTL=3600

